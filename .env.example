# AWS credentials are resolved via the normal boto3 chain (aws configure / aws login / env vars) --
# do not put access keys in this file. Only non-secret configuration goes here.

# AWS CLI profile to use for Bedrock calls.
AWS_PROFILE=axxess-triaxis

# Region where Bedrock model access has been enabled for the chosen model.
# Confirmed working via us-east-1 for this account -- ap-south-2 returned
# ResourceNotFoundException ("Model use case details have not been submitted")
# even after the Anthropic use-case form was submitted, so the global.*
# cross-region profile's access grant appears to live in us-east-1 specifically.
BEDROCK_REGION=us-east-1

# Bedrock model id (must have model access enabled in the console for this account/region).
# TEMPORARY FALLBACK: global.anthropic.claude-sonnet-4-6 is the intended model, but it
# currently fails with AccessDeniedException/INVALID_PAYMENT_INSTRUMENT -- Anthropic models
# on Bedrock are sold via AWS Marketplace, which needs a valid payment method on the account
# (AWS Billing console -> Payment preferences). Using amazon.nova-pro-v1:0 (an AWS first-party
# model, no Marketplace subscription needed) until that's fixed, then switch back to Claude.
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0

# Nebius Token Factory API key, from https://tokenfactory.nebius.com (Organization ->
# API keys) -- do not commit a real value here. Entirely opt-in: unset means get_model()
# (models.py) returns exactly the same plain BedrockModel it always did. When set,
# get_model() returns a Strands ModelRouter that tries Nebius/Nemotron first and falls
# back to Bedrock automatically (FallbackStrategy) if the Nebius endpoint is ever
# unavailable -- Bedrock stays the safety net, not something this replaces. Built for the
# Nebius x NVIDIA Global AI Hackathon (Personal AI track).
NEBIUS_API_KEY=

# Optional overrides -- sensible defaults are hardcoded in models.py if left unset.
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# NEBIUS_MODEL_ID=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# NEBIUS_MAX_TOKENS=8000

# AssemblyAI API key, from https://www.assemblyai.com/app/account -- do not commit a real value here.
ASSEMBLYAI_API_KEY=

# CALL-E API key, from https://dashboard.heycall-e.com/account/api-keys -- do not commit a real value here.
CALLE_API_KEY=

# --- Everything below is OPTIONAL. Triage runs exactly as before if left unset. ---

# Twilio Lookup credentials, from https://console.twilio.com -- adds a second, independent
# carrier/line-type signal (carrier_intel.py) alongside the transcript-content scam heuristic.
# Unset means check_carrier_intel reports "unavailable," which never blocks a decision the
# transcript heuristic can make on its own.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Google Sheets sync (crm_sheets.py) -- appends every triaged voicemail/message as a row in a
# Sheet, so results sit next to CRM tooling a small business already uses. Needs a Google Cloud
# service account JSON key file (path here) AND the target Sheet shared with that service
# account's own email (the `client_email` field in the key file) with Editor access. Unset
# means CRM sync is skipped entirely -- it is strictly opt-in and never blocks triage; see
# triage._sync_to_crm_if_configured.
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SHEET_ID=

# WhatsApp Business Cloud API (whatsapp_webhook.py) -- lets Callismatic triage incoming
# WhatsApp messages through the exact same pipeline as a voicemail (triage_text_message).
# WHATSAPP_APP_ID/WHATSAPP_APP_SECRET come from the Meta App dashboard (Settings -> Basic).
# WHATSAPP_VERIFY_TOKEN is a string YOU make up -- paste the same value into Meta's
# WhatsApp -> Configuration -> Webhook setup. WHATSAPP_ACCESS_TOKEN/WHATSAPP_PHONE_NUMBER_ID
# come from WhatsApp -> API Setup and are only needed to send replies (send_whatsapp_message);
# receiving and triaging incoming messages works without them. Run with:
#   uvicorn callismatic.whatsapp_webhook:app --port 8000
# then point a public HTTPS URL (a tunnel like ngrok for testing, real hosting for production)
# at it and register that URL + WHATSAPP_VERIFY_TOKEN in the Meta App dashboard.
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Google Calendar (calendar_sync.py) -- reuses the SAME GOOGLE_SERVICE_ACCOUNT_FILE as Sheets
# above (Calendar, like Sheets, supports sharing one specific resource with a service
# account's email -- unlike Google Tasks, which has no sharing model and would need full
# OAuth). Share one calendar with that email (Settings and sharing -> Share with specific
# people -> "Make changes to events"), then set its ID here (a personal calendar's ID is
# usually just its owner's Gmail address).
GOOGLE_CALENDAR_ID=

# Todoist personal API token (todoist_sync.py) -- Settings -> Integrations -> Developer ->
# API token. A plain bearer token, no OAuth flow needed for your own account. Unset means
# to-do items still work locally (todos.py, `callismatic todos`), just without Todoist sync.
TODOIST_API_TOKEN=
